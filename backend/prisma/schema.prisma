generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum Setting {
  INDOOR
  OUTDOOR
  EITHER
}

enum Intensity {
  LOW
  MODERATE
  HIGH
}

enum GroupStatus {
  PLANNING
  COMPLETED
  CANCELLED
}

enum VoteChoice {
  YES
  MAYBE
  NO
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  preferences    Preference?
  memberships    Membership[]
  tried          UserExperience[]
  feedback       Feedback[]
  votes          Vote[]
  invitations    Invitation[] @relation("InvitationCreator")
  shortlistAdds  ShortlistItem[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Preference {
  userId          String   @id
  budgetPerPerson Int?
  maxDistanceKm   Float?
  homeLatitude    Float?
  homeLongitude   Float?
  maxDurationMins Int?
  preferredTypes  String[] @default([])
  dislikedTypes   String[] @default([])
  preferredTags   String[] @default([])
  dislikedTags    String[] @default([])
  setting         Setting  @default(EITHER)
  maxIntensity    Intensity @default(HIGH)
  accessibility   String[] @default([])
  dietaryNeeds    String[] @default([])
  naturalLanguage String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invitations Invitation[]
  shortlists  Shortlist[]
  outings     Outing[]
  votes       Vote[]
  runs        RecommendationRun[]
  preferences GroupPreference?
}

model GroupPreference {
  groupId          String   @id
  budgetPerPerson  Int?
  maxDistanceKm    Float?
  homeLatitude     Float?
  homeLongitude    Float?
  maxDurationMins  Int?
  setting          Setting  @default(EITHER)
  maxIntensity     Intensity @default(HIGH)
  updatedAt        DateTime @updatedAt
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Membership {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId])
}

model Invitation {
  id          String   @id @default(cuid())
  groupId     String
  tokenHash   String   @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([groupId, expiresAt])
}

model Experience {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  description       String
  category          String
  tags              String[]  @default([])
  priceMin          Int?
  priceMax          Int?
  currency          String?   @default("INR")
  locationName      String?
  latitude          Float?
  longitude         Float?
  durationMins      Int?
  setting           Setting?  @default(EITHER)
  intensity         Intensity? @default(MODERATE)
  socialLevel       Int?
  adventureLevel    Int?
  minGroupSize      Int       @default(1)
  maxGroupSize      Int?
  accessibilityFeatures String[] @default([])
  dietaryOptions    String[]  @default([])
  source            String    @default("unknown")
  sourceUrl         String?
  eventStartsAt     DateTime?
  eventLocalDate    String?
  eventLocalTime    String?
  eventTimeZone     String?
  bookingUrl        String?
  lastVerifiedAt    DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  triedBy           UserExperience[]
  shortlistItems    ShortlistItem[]
  feedback          Feedback[]
  votes             Vote[]
  outings           Outing[]
  @@index([category, active])
  @@index([priceMin, priceMax])
}

model UserExperience {
  id           String     @id @default(cuid())
  userId       String
  experienceId String
  triedAt      DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  @@unique([userId, experienceId])
}

model Shortlist {
  id        String          @id @default(cuid())
  groupId   String
  createdAt DateTime        @default(now())
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items     ShortlistItem[]
  @@unique([groupId])
}

model ShortlistItem {
  id           String     @id @default(cuid())
  shortlistId  String
  experienceId String
  addedById    String
  note         String?
  createdAt    DateTime   @default(now())
  shortlist    Shortlist  @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  addedBy      User       @relation(fields: [addedById], references: [id], onDelete: Cascade)
  @@unique([shortlistId, experienceId])
}

model Vote {
  id           String     @id @default(cuid())
  userId       String
  experienceId String
  groupId      String
  choice       VoteChoice
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([userId, experienceId, groupId])
}

model Outing {
  id           String       @id @default(cuid())
  groupId      String
  experienceId String
  scheduledAt  DateTime?
  status       GroupStatus  @default(PLANNING)
  createdAt    DateTime     @default(now())
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  experience   Experience   @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  feedback     Feedback[]
}

model Feedback {
  id                   String     @id @default(cuid())
  outingId             String
  userId               String
  experienceId         String
  enjoyment             Int
  wouldRepeat          Boolean
  adventure            Int?
  socialAtmosphere     Int?
  valueForMoney        Int?
  difficulty           Int?
  comments             String?
  predictionAtTime     Float?
  modelVersion         String?
  featureSnapshot      Json?
  createdAt            DateTime   @default(now())
  outing                Outing     @relation(fields: [outingId], references: [id], onDelete: Cascade)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience            Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  @@unique([outingId, userId])
  @@index([userId, createdAt])
}

model RecommendationRun {
  id               String   @id @default(cuid())
  groupId          String
  modelVersion     String
  inputSnapshot    Json
  resultSnapshot   Json
  createdAt        DateTime @default(now())
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@index([groupId, createdAt])
}

model ModelEvaluation {
  id               String   @id @default(cuid())
  modelVersion     String   @unique
  selectedModel    String
  ratings          Int
  outings          Int
  mae              Float
  baselineMae      Float
  candidateMae     Json
  validationMethod String
  createdAt        DateTime @default(now())
  @@index([createdAt])
}
